{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Makefile Build",
      "type": "shell",
      "command": "make",
      "args": [
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Makefile Debug Build",
      "type": "shell",
      "command": "make",
      "args": [
        "debug-build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": ["$go"]
    }
  ]
}
